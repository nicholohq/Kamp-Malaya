# Environment variables for the Kamp Malaya site.
# Names and shapes only — never commit real values. Set these in
# Vercel → Settings → Environment Variables.
#
# IMPORTANT: Vercel applies env var changes to NEW deployments only. After
# changing any of these you must redeploy for them to take effect.

# --- GoHighLevel -------------------------------------------------------------
# v2 Private Integration Token (Settings → Private Integrations).
# Scopes actually used by this repo — grant these four and no more:
#   contacts.readonly         admin dashboard (list, detail, notes)
#   contacts.write            ghl-webhook.js (upsert, tags, notes)
#   calendars/events.readonly availability.js (blocked slots)
#   calendars/events.write    block-dates.js (block slots)
GHL_API_KEY=

# Optional shared secret for the block-dates webhook. If unset, that endpoint
# is open — set it.
BLOCK_DATES_TOKEN=

# --- Admin dashboard ---------------------------------------------------------
# scrypt hash of the admin password. Generate with:
#   node scripts/hash-admin-password.mjs
# This is the SEED and the RECOVERY PATH, not the live password: once the owner
# changes the password in the app it lives in Redis and takes precedence.
# Delete the `admin:password` key in Upstash to fall back to this value.
ADMIN_PASSWORD_HASH=

# HMAC key for session cookies. 32+ random bytes, and NOT the password:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# How long a login lasts. Defaults to 12 if unset.
ADMIN_SESSION_TTL_HOURS=12

# Exact origin allowed to call /api/admin/*. Defaults to the production host.
ADMIN_ORIGIN=https://www.kampmalaya.tours

# --- Upstash Redis -----------------------------------------------------------
# Injected automatically by the Vercel Marketplace integration; listed here so
# it is obvious the admin area depends on them. (Stores migrated from the
# retired Vercel KV product use the KV_REST_API_* names instead — both work.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
