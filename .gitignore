# Dependencies (Vercel runs `npm install` — committing these breaks the
# Linux build because executables lose their +x bit on Windows checkout)
node_modules/

# Build output (Vercel rebuilds via `npm run build`)
dist/
dist-ssr/

# Local backups / scratch — not needed in the repo or the deploy
originals-backup/
photos-to-rename/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
.idea/

# Env
.env
.env.*
.local

# Vercel
.vercel

.vercel
.env*

# Impeccable design skill — vendored by `npx impeccable install` (148 files per
# harness) and reinstallable at any time, so it doesn't belong in the repo.
# Scoped paths: .opencode/plans/ is tracked, so don't ignore .opencode wholesale.
.claude/skills/impeccable/
.opencode/skills/impeccable/

# Impeccable critique snapshots — regenerated on each run
.impeccable/

# Claude Code per-machine settings (permissions, local overrides). launch.json
# sits alongside it and IS shared — it defines the dev server for the preview.
.claude/settings.local.json
